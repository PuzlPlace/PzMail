{
    "name": "puzl/pzmail",
    "description": "SMTP mail sender via Symfony Mailer for Laravel (Puzl ecosystem)",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "symfony/mailer": "^6.4|^7.0",
        "symfony/mime": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Puzl\\PzMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puzl\\PzMail\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "test:coverage": "phpunit -c phpunit.xml.dist --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.26"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Puzl\\PzMail\\Laravel\\PzMailServiceProvider"
            ]
        }
    }
}
